# Anthropic Messages compatible model (for example Tencent Cloud TokenHub).
# Leave the token unset to use demo/rule-based fallbacks.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://tokenhub.tencentmaas.com
ANTHROPIC_MODEL=glm-5.3-flash

# Switch to DeepSeek V4 Flash by setting:
# ANTHROPIC_MODEL=deepseek-v4-flash

# Optional legacy OpenAI-compatible configuration. Anthropic config takes priority when both are set.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
